#!/usr/bin/env bash
# Copy this file to env.sh and fill in private cluster values.
# env.sh is ignored by Git because it may contain passwords.

# Worker and shared task root.
export PDSHELL_ROOT=/path/to/PDShell/tasks
export PDSHELL_POLL_INTERVAL=1

# Client/frontend transport. Use rsync for submission, scp for read-only monitoring.
export PDSHELL_TRANSPORT=rsync
export PDSHELL_REMOTE_ROOT=/path/to/PDShell/tasks
export PDSHELL_CACHE="$HOME/.cache/pdshell"
export PDSHELL_PORT=7860
# Optional explicit endpoint; otherwise SSH_HOST + REMOTE_ROOT are combined.
# export PDSHELL_ENDPOINT=user@cluster.example:/path/to/PDShell/tasks

# SSH connection. Prefer keys; only set a password through a secret injector.
export PDSHELL_SSH_HOST=cluster.example
export PDSHELL_SSH_USER=user
export PDSHELL_SSH_PORT=22
# Prefer SSH keys. Only set this when password authentication is unavoidable.
# export PDSHELL_SSH_PASSWORD='inject-from-a-secret-store'

# Project deployment target used by sync_to_server.sh.
export PDSHELL_REMOTE_PROJECT_DIR=/path/to/PDShell
export PDSHELL_DEPLOY_TARGET=user@cluster.example:/path/to/PDShell

# Optional GPU selection for training scripts and gpu_test.sh.
# export CUDA_VISIBLE_DEVICES=0
